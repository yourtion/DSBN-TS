{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "sourceMap": true,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
